{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-voice/data/channels.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "from": {
          "description": "From frequency: Frequencies as the radio shows them, for example 1 to 10 or 1.5.",
          "type": "number",
          "minimum": 0.01,
          "maximum": 1000000
        },
        "to": {
          "description": "To frequency: Frequencies as the radio shows them, for example 1 to 10 or 1.5.",
          "type": "number",
          "minimum": 0.01,
          "maximum": 1000000
        },
        "jobs": {
          "description": "Jobs: Only members of these jobs can use it. Leave jobs and gangs empty for everyone.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "gangs": {
          "description": "Gangs: Members of these gangs can use it too.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "onDuty": {
          "description": "Only on duty: Job members must be on duty in that job.",
          "type": "boolean"
        },
        "anim": {
          "description": "Animation: The radio animation on these frequencies (the default one, none, or a set).",
          "enum": [
            "",
            "none",
            "shoulder",
            "chatter",
            "handheld",
            "custom"
          ]
        }
      },
      "required": [
        "label",
        "from",
        "to"
      ]
    }
  },
  "additionalProperties": false
}
